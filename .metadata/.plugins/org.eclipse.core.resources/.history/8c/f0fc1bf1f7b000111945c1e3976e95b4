package tp_solid;

import java.text.SimpleDateFormat;
import java.util.Date;

import tp_solid.util.Pair;

public class AfficherXML implements AfficherPlanning {

	@Override
	public void afficherPL(Etudiant e) {
		SimpleDateFormat df = new SimpleDateFormat("dd/MM/yyyy");
		
		String str = "<planning>";
		str = str + "\n\t<etudiant nom='" + e.getNom() + "'/>";
		for (Pair<Date,Projet> pair : e.getJoursTravailles()) {
			Date date = pair.getL();
			Projet projet = pair.getR();
			str = str + "\n\t<item projet='" + projet.getNom() + "' date='" + df.format(date) + "' />";
		}
		str = str + "\n</planning>";
		System.out.println(str);

	}

}
